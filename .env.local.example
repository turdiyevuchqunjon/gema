# ====================================
# HEMMORT - .env.local
# Bu faylni .env.local deb nomlang va kalitlarni to'ldiring
# ====================================

# --- SAYT ---
NEXT_PUBLIC_SITE_URL=https://hemmort.uz

# --- META PIXEL & CONVERSIONS API ---
# https://business.facebook.com/events_manager
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_ACCESS_TOKEN=
# Test paytida ishlatish uchun (production'da bo'sh qoldiring)
META_TEST_EVENT_CODE=
# Meta webhook subscription uchun (ixtiyoriy)
META_WEBHOOK_VERIFY_TOKEN=

# --- AMOCRM ---
# https://www.amocrm.ru/developers
AMOCRM_DOMAIN=yourdomain.amocrm.ru
AMOCRM_ACCESS_TOKEN=
# Pipeline va boshlang'ich status (yangi lid qaysi voronkaga tushishi)
AMOCRM_PIPELINE_ID=
AMOCRM_STATUS_ID=
# SOTILDI bosqichi ID (Purchase event yuborish uchun)
AMOCRM_SOLD_STATUS_ID=
# AmoCRM custom field ID lar (FBP/FBC saqlash uchun kontaktda)
AMOCRM_FIELD_FBP=
AMOCRM_FIELD_FBC=
# Webhook secret (https://yourdomain/api/amocrm-purchase?secret=XXX)
AMOCRM_WEBHOOK_SECRET=

# --- TELEGRAM BOT ---
# @BotFather dan token oling, @userinfobot dan chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
